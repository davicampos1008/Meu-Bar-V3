-- Meu Bar — RESET ÚNICO: 149 receitas que usam SOMENTE ingredientes do seu estoque.
-- 1) Apaga receitas sem pedidos no histórico (receitas com pedidos ficam, para não perder vendas).
delete from recipes r where not exists (select 1 from orders o where o.recipe_id = r.id);

