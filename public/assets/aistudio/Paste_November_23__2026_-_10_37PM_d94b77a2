select
  v.name, v.category,
  (select jsonb_agg(
      jsonb_build_object(
        'name',p[1],'nome',p[1],'item',p[1],'ingredient',p[1],'ingrediente',p[1],
        'variant',nullif(p[2],''),'variante',nullif(p[2],''),
        'qty',p[3]::numeric,'quantity',p[3]::numeric,'quantidade',p[3]::numeric,'amount',p[3]::numeric,
        'unit',p[4],'unidade',p[4])
      || case when p[4]='ml' then jsonb_build_object('ml',p[3]::numeric) else '{}'::jsonb end
      order by o)
   from unnest(string_to_array(v.ing,';')) with ordinality as t(x,o)
